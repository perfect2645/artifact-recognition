FROM mcr.microsoft.com/dotnet/aspnet:10.0

WORKDIR /app

# Copy published output from host ./publish folder into container /app
COPY ../../publish .

# Default environment (will be overridden by docker run env)
ENV ASPNETCORE_HTTP_PORTS=7092
ENV ASPNETCORE_ENVIRONMENT=Production

EXPOSE 7092

# Ensure a writable logs folder exists and has permissive permissions so
# both the container process and any host bind-mount can write to it.
RUN mkdir -p /app/logs && CHOWN app:app /app/logs

USER app

# Entry point
ENTRYPOINT ["dotnet", "artifact.service.domain.dll"]
