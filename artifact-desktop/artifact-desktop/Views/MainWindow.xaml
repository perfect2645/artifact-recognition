<Window x:Class="artifact.desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Artifact Automation" 
        Height="680" Width="1100"
        MinHeight="560" MinWidth="900"
        Background="#F7F8FA"
        Style="{StaticResource MaterialDesignWindow}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="NavigationItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="8, 2" />
            <Setter Property="Padding" Value="14, 0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBackground"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center">
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="#F3F4F6" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="#EDE9FE" />
                                <Setter Property="Foreground" Value="#5B21B6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="NavigationItemTemplate">
            <Grid AutomationProperties.Name="{Binding Label}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />

                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Width="20" Height="20"
                                         VerticalAlignment="Center"
                                         Kind="{Binding Icon}">
                </materialDesign:PackIcon>
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="Medium"
                           Text="{Binding Label}">
                </TextBlock>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top"
                      Margin="20,24,20,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="36" Height="36"
                            HorizontalAlignment="Left"
                            Background="#5B21B6"
                            CornerRadius="6">
                        <materialDesign:PackIcon Width="22" Height="22"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Foreground="White"
                                                 Kind="ImageFilterCenterFocus">
                        </materialDesign:PackIcon>                            
                    </Border>
                    <StackPanel Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Text="Artifact" />
                        <TextBlock FontSize="11"
                                 FontWeight="SemiBold"
                                 Foreground="#6B7280"
                                 Text="Automation" />
                    </StackPanel>
                </Grid>

                <ListBox ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavigationItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemTemplate="{StaticResource NavigationItemTemplate}">
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1"
                        Content="{Binding Navigation.CurrentViewModel}" />
    </Grid>
</Window>
