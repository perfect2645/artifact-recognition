<UserControl x:Class="artifact.desktop.Views.RecognitionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:artifact.desktop.Views"
             xmlns:controls="clr-namespace:artifact.desktop.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
            <controls:FolderDialogControl
                DockPanel.Dock="Left"
                EnableGatherFiles="True"
                FilesSearchPattern="*.dcm"
                SelectedFolderPath="{Binding FolderDialogViewModel.InputFolderPath, Mode=OneWayToSource}"
                GatheredFiles="{Binding FolderDialogViewModel.GatheredFiles, Mode=OneWayToSource}" />
            
            <Button Content="Start Recognition"
                    Command="{Binding StartRecognitionCommand}"
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    Width="150"
                    Margin="10,0" />
        </DockPanel>
    </Grid>
</UserControl>
