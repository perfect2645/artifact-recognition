<UserControl x:Class="artifact.desktop.Views.Recognition.RecognitionBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:views="clr-namespace:artifact.desktop.Views"
             xmlns:local="clr-namespace:artifact.desktop.Views.Recognition"
             DataContext="{Binding BannerViewModel}">
    <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E5E7EF"
                BorderThickness="1"
                CornerRadius="9"
                Padding="16,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="34"
                        Height="36"
                        Background="#F0EBFC"
                        CornerRadius="7"
                        HorizontalAlignment="Left">
                <materialDesign:PackIcon Kind="FolderOpenOutline"
                                             Foreground="#6B42CE"
                                             Width="21"
                                             Height="21"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                <TextBlock Text="{Binding FolderName}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding FolderDescription}"
                               Style="{StaticResource MutedText}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding FolderDescription}"
                               Margin="0,3,0,0" />
            </StackPanel>

            <Button Grid.Column="2"
                        Command="{Binding SelectFolderCommand}"
                        Content="{Binding FolderButtonLabel}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,12,0"
                        Padding="12,0"
                        FontSize="12" />

            <Button Grid.Column="3"
                        Command="{Binding DataContext.StartRecognitionCommand, RelativeSource={RelativeSource AncestorType={x:Type views:RecognitionView}}}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#6B42CE"
                        BorderBrush="#6B42CE"
                        Padding="14,0"
                        FontSize="12">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Play"
                                                Width="17"
                                                Height="17"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DataContext.StartButtonLabel, RelativeSource={RelativeSource AncestorType={x:Type views:RecognitionView}}}"
                                   VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
