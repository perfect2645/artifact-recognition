<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:artifact.desktop.Views"
                    xmlns:viewModels="clr-namespace:artifact.desktop.ViewModels">
    <DataTemplate DataType="{x:Type viewModels:SingleImageVm}">
        <views:SingleImageView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewModels:RecognitionViewModel}">
        <views:RecognitionView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
        <views:SettingsView />
    </DataTemplate>
</ResourceDictionary>