<UserControl x:Class="artifact_automation_desktop.Views.SingleImage.SingleImageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:artifact_automation_desktop.Controls"
             Padding="20, 10"
             FontSize="30">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="200"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Single image recognition" Style="{StaticResource PageTitle}" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:ImageUploadControl Grid.Column="0"
                HorizontalAlignment="Left"
                SelectedImagePath="{Binding SelectedImagePath}" />
            
            <Button Grid.Column="1" Width="100" 
                    Content="Start"
                    Command="{Binding StartCommand}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding RecognitionStatus}"></TextBlock>
                <TextBox IsReadOnly="True" 
                         Margin="50, 0,0,0"
                         Text="{Binding OutputPath}"></TextBox>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Result: "></TextBlock>
                    <TextBlock 
                               Foreground="Green"
                               Margin="10,0,0,0"
                               Text="{Binding RecognitionResult}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
