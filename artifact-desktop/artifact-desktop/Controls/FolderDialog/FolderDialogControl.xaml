<UserControl x:Class="artifact.desktop.Controls.FolderDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:artifact.desktop.Controls">
    <UserControl.DataContext>
        <local:FolderDialogViewModel />
    </UserControl.DataContext>
    <Grid>
        <StackPanel>
            <Button Content="Select Folder"
                    Width="150" Height="30" Margin="10"
                    Command="{Binding OpenFolderDialog}"/>
        </StackPanel>
    </Grid>
</UserControl>
