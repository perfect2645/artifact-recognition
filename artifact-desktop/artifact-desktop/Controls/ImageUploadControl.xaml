<UserControl x:Class="artifact_automation_desktop.Controls.ImageUploadControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="NormalBorder" Color="#D0D0D0"/>
        <SolidColorBrush x:Key="HoverBorder" Color="#64A8FF"/>
        <SolidColorBrush x:Key="DragActiveBorder" Color="#227FFF"/>
        <SolidColorBrush x:Key="BgNormal" Color="#F7F8FA"/>
        <SolidColorBrush x:Key="BgDrag" Color="#E8F2FF"/>
        <SolidColorBrush x:Key="TextHint" Color="#999999"/>
    </UserControl.Resources>

    <Border x:Name="MainBorder"
            CornerRadius="10"
            BorderThickness="2"
            BorderBrush="{StaticResource NormalBorder}"
            Background="{StaticResource BgNormal}"
            AllowDrop="True"
            MouseLeftButtonDown="MainBorder_MouseClick"
            DragEnter="Panel_DragEnter"
            DragLeave="Panel_DragLeave"
            Drop="Panel_Drop">

        <Grid>
            <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed"/>

            <StackPanel x:Name="EmptyTipPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock FontSize="40" Foreground="{StaticResource TextHint}" Text="🖼"/>
                <TextBlock FontSize="15" Foreground="{StaticResource TextHint}" Margin="0,10,0,5">
                    Select or drag an image
                </TextBlock>
                <TextBlock FontSize="12" Foreground="#BBBBBB">
                    supports JPG / PNG / BMP / WEBP
                </TextBlock>
            </StackPanel>

            <Button x:Name="BtnClear"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="26" Height="26" Margin="8"
                    Background="#CC3333" Foreground="White"
                    BorderThickness="0" 
                    Visibility="Collapsed" Click="BtnClear_Click">
                <TextBlock Text="×" FontSize="16"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
